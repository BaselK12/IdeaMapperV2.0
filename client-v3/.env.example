# ─────────────────────────────────────────────────────────────────────────────
# IdeaMapper V3 — environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# All VITE_* variables are embedded in the browser bundle at build time.
# Never put secret keys (service_role, DB password, etc.) in VITE_* vars.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase connection ──────────────────────────────────────────────────────
# Find these at: supabase.com → your project → Settings → API
# VITE_SUPABASE_URL  : the "Project URL"
# VITE_SUPABASE_ANON_KEY : the "anon public" key (safe to expose to the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── E2E test accounts (Playwright — not used by the app at runtime) ─────────
# Both accounts must already exist in your Supabase project.
# Create them via the Supabase dashboard → Authentication → Users.
#
# Admin account  – must be able to create maps (map_limit >= 1 in profiles).
# Viewer account – a separate account that owns no maps of its own.
E2E_ADMIN_EMAIL=admin-e2e@yourdomain.com
E2E_ADMIN_PASSWORD=change-me

E2E_VIEWER_EMAIL=viewer-e2e@yourdomain.com
E2E_VIEWER_PASSWORD=change-me
