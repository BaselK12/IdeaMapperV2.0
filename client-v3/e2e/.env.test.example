# E2E test credentials
# ─────────────────────────────────────────────────────────────────────────────
# These four variables must be added to client-v3/.env.local.
# They are NOT loaded from a separate file — .env.local is the single source of
# truth for both app config (VITE_*) and E2E config (E2E_*).
#
# The accounts must already exist in your Supabase project.
# Create them manually via the Supabase dashboard or auth admin API.
#
# Admin account  — must be able to create maps (map_limit >= 1 in profiles).
# Viewer account — a separate account that has no maps of its own.
#                  globalSetup will add it as a viewer on the shared test map.
# ─────────────────────────────────────────────────────────────────────────────

E2E_ADMIN_EMAIL=admin-e2e@example.com
E2E_ADMIN_PASSWORD=change-me

E2E_VIEWER_EMAIL=viewer-e2e@example.com
E2E_VIEWER_PASSWORD=change-me
