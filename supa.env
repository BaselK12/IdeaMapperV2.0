# ─────────────────────────────────────────────────────────────────────────────
# supa.env — LEGACY FILE, NOT LOADED BY VITE AT RUNTIME
#
# This file was used in an earlier setup and is now a stale artifact.
# The active app reads VITE_* variables from client-v3/.env.local,
# which is gitignored and must never be committed.
#
# See client-v3/.env.example for the correct template.
#
# After running `git rm --cached supa.env` this file will be untracked.
# You may then delete it or keep it locally — it will be ignored by git.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
